# Copy this file to .env.local and fill in the values for local development.
# cp .env.example .env.local

# Supabase public browser/server URL.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase public anonymous key. This is safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase service role key.
# Never expose this value to client bundles or browser code.
SUPABASE_SERVICE_ROLE_KEY=
